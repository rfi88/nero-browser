    def inject_adblocker(self):
        adblock_js = """
        (function() {
            if (window.location.href === "about:blank") return;
            const blockSelectors = [
                '.video-ads', '.ytp-ad-module', '.ytp-ad-overlay-container',
                '#player-ads', '#masthead-ad', 'ytd-ad-slot-renderer',
                'iframe[src*="googleads"]', 'div[id^="div-gpt-ad"]', '.ad-box'
            ];
            function removeAds() {
                blockSelectors.forEach(selector => {
                    document.querySelectorAll(selector).forEach(el => el.remove());
                });
                let skipBtn = document.querySelector('.ytp-ad-skip-button, .ytp-ad-skip-button-modern');
                if (skipBtn) { skipBtn.click(); }
                let video = document.querySelector('video');
                let adShowing = document.querySelector('.ad-showing, .ad-interrupting');
                if (video && adShowing) { video.currentTime = video.duration || 0; }
            }
            setInterval(removeAds, 500);
        })();
        """
        script = QWebEngineScript()
        script.setSourceCode(adblock_js)
        script.setInjectionPoint(QWebEngineScript.InjectionPoint.DocumentReady)
        script.setWorldId(QWebEngineScript.ScriptWorldId.MainWorld)
        script.setRunsOnSubFrames(True)
        self.custom_profile.scripts().insert(script)

