        dialog.exec()

    def show_history_manager(self):
        dialog = DataManagerDialog("Riwayat Penjelajahan", HISTORY_FILE, self.open_url_in_current_tab, self, is_history=True)
        dialog.exec()

    def open_url_in_current_tab(self, url_str):
        if self.container.currentWidget():
            self.container.currentWidget().load(QUrl(url_str))

    def add_current_to_bookmarks(self):
        view = self.container.currentWidget()
        if not view: return
        url = view.url().toString()
        title = view.title() or url
        bookmarks = []
        if os.path.exists(BOOKMARKS_FILE):
            try:
                with open(BOOKMARKS_FILE, "r") as f: bookmarks = json.load(f)
            except: pass
        if not any(b.get('url') == url for b in bookmarks):
            bookmarks.append({"title": title, "url": url})
            try:
                with open(BOOKMARKS_FILE, "w") as f: json.dump(bookmarks, f, indent=4)
            except: pass

    def log_to_history(self, title, url_str):
        if not url_str or url_str == "about:blank" or "google.com/search" in url_str: return
        history = []
        if os.path.exists(HISTORY_FILE):
            try:
                with open(HISTORY_FILE, "r") as f: history = json.load(f)
            except: pass
        now_str = datetime.now().strftime("%H:%M:%S")
        history.append({"title": title or url_str, "url": url_str, "time": now_str})
        if len(history) > 500: history.pop(0)
        try:
            with open(HISTORY_FILE, "w") as f: json.dump(history, f, indent=4)
        except: pass

    def download_youtube_video(self):
        view = self.container.currentWidget()
        if not view: return
        url_str = view.url().toString()
        if "youtube.com/watch" not in url_str: return
        self.btn_yt_download.setEnabled(False)
        self.btn_yt_download.setText("⏳")
        self.extractor_thread = YouTubeExtractorThread(url_str)
        self.extractor_thread.extraction_done.connect(self.handle_youtube_extraction_result)
        self.extractor_thread.start()

    def handle_youtube_extraction_result(self, status, stream_url_or_source, file_name):
        self.btn_yt_download.setEnabled(True)
        self.btn_yt_download.setText("📥")
        download_dir = os.path.expanduser("~/Downloads")
        output_path = os.path.join(download_dir, file_name)

        if status == "success":
            try:
                req_data = json.dumps({
                    "jsonrpc": "2.0", "id": "nero", "method": "aria2.addUri",
                    "params": [[stream_url_or_source], {"dir": download_dir, "out": file_name}]
                }).encode()
                req = urllib.request.Request("http://localhost:6800/jsonrpc", data=req_data, headers={'Content-Type': 'application/json'})
                with urllib.request.urlopen(req, timeout=1) as response:
                    gid = json.loads(response.read().decode())['result']
                self.show_download_manager()
                self.dl_manager.add_download(gid, file_name)
            except Exception as e: print(f"Aria2c Error: {e}")
        elif status == "use_ytdlp_direct":
            subprocess.Popen(["yt-dlp", "--no-playlist", "--js-runtimes", "node", "-f", "b", "-o", output_path, stream_url_or_source], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            QMessageBox.information(self, "Mendownload Live/HLS Stream", f"Video siaran langsung sedang diunduh langsung lewat mesin yt-dlp.\n\nFile disimpan ke: Downloads/{file_name}")
        elif status == "error":
            QMessageBox.warning(self, "Download Error", f"Gagal memproses link:\n{stream_url_or_source}")
        else:
            QMessageBox.warning(self, "Download Gagal", "Gagal mengekstrak video. Pastikan video tersedia/tidak diblokir.")

    def add_tab(self, url_str):
        view = QWebEngineView()
        page = NeroWebPage(self.custom_profile, view)
        view.setPage(page)
        page.settings().setAttribute(QWebEngineSettings.WebAttribute.FullScreenSupportEnabled, True)

        view.urlChanged.connect(lambda qurl, v=view: self.update_url_bar(qurl, v))
        view.loadProgress.connect(self.handle_load_progress)
        view.titleChanged.connect(lambda title, v=view: self.handle_title_changed(title, v))
        page.fullScreenRequested.connect(self.handle_fullscreen_request)

        self.browsers.append(view)
        self.container.addWidget(view)
        self.tab_bar.addTab("Loading...")
        self.tab_bar.setCurrentIndex(self.tab_bar.count() - 1)
        self.container.setCurrentWidget(view)
        view.load(QUrl(url_str))

    def handle_title_changed(self, title, view):
        self.update_tab_title(title, view)
        if title and title != "Loading...": self.log_to_history(title, view.url().toString())

    def handle_fullscreen_request(self, request):
        request.accept()
        if request.toggleOn():
            self.nav_bar.hide()
            self.tab_bar.hide()
            self.showFullScreen()
        else:
            self.nav_bar.show()
            self.tab_bar.show()
            self.showNormal()

    def switch_tab(self, index):
        if index >= 0:
            view = self.browsers[index]
            self.container.setCurrentWidget(view)
            self.url_bar.setText(view.url().toString())
            url_str = view.url().toString()
            self.btn_yt_download.setEnabled("youtube.com/watch" in url_str)

    def close_tab(self, index):
        if self.tab_bar.count() > 1:
            self.tab_bar.removeTab(index)
            view = self.browsers.pop(index)
            self.container.removeWidget(view)
            view.deleteLater()

    def current_browser_action(self, action):
        return lambda: getattr(self.container.currentWidget(), action)() if self.container.currentWidget() else None

    def navigate_to_url(self):
        q = self.url_bar.text()
        if not q.startswith("http://") and not q.startswith("https://"):
            if "." in q and " " not in q: q = "https://" + q
            else: q = f"https://www.google.com/search?q={q}"
        self.container.currentWidget().load(QUrl(q))

    def update_url_bar(self, qurl, view):
        if view == self.container.currentWidget():
            url_str = qurl.toString()
            self.url_bar.setText(url_str)
            self.btn_yt_download.setEnabled("youtube.com/watch" in url_str)

    def update_tab_title(self, title, view):
        if view in self.browsers:
            index = self.browsers.index(view)
            short_title = title[:12] + "..." if len(title) > 12 else title
            self.tab_bar.setTabText(index, short_title)

    def handle_load_progress(self, progress):
        self.progress_bar.setValue(progress)
        if progress < 100:
            self.progress_bar.show()
            self.btn_spinner.setText("⟳")
            self.btn_spinner.setStyleSheet("color: #00ddff; font-weight: bold;")
        else:
            self.progress_bar.hide()
            self.btn_spinner.setText("✖")
            self.btn_spinner.setStyleSheet("color: #94949e;")

    def handle_aria2_download(self, download_item):
        file_url = download_item.url().toString()
        suggested_name = download_item.suggestFileName() if hasattr(download_item, 'suggestFileName') else download_item.suggestedFileName()
        download_item.cancel()
        download_dir = os.path.expanduser("~/Downloads")
        try:
            req_data = json.dumps({
                "jsonrpc": "2.0", "id": "nero",
                "method": "aria2.addUri", "params": [[file_url], {"dir": download_dir, "out": suggested_name}]
            }).encode()
            req = urllib.request.Request("http://localhost:6800/jsonrpc", data=req_data, headers={'Content-Type': 'application/json'})
            with urllib.request.urlopen(req, timeout=1) as response:
                gid = json.loads(response.read().decode())['result']
            self.show_download_manager()
            self.dl_manager.add_download(gid, suggested_name)
        except Exception as e: print(f"Internal Download Error: {e}")

if __name__ == "__main__":
    app = QApplication(sys.argv)
    browser = NeroBrowser()
    browser.show()
    sys.exit(app.exec())
