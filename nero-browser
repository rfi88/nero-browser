class YouTubeExtractorThread(QThread):
    extraction_done = pyqtSignal(str, str, str)

    def __init__(self, youtube_url):
        super().__init__()
        self.youtube_url = youtube_url

    def run(self):
        try:
            # SAKTI: Ditambahkan --no-playlist agar tidak nyangkut saat buka YouTube Mix / Playlist!
            cmd_title = ["yt-dlp", "--no-playlist", "--js-runtimes", "node", "--get-title", self.youtube_url]
            proc_title = subprocess.Popen(cmd_title, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            stdout_title, _ = proc_title.communicate(timeout=15)
            title = stdout_title.strip() if proc_title.returncode == 0 else "YouTube_Video"

            clean_title = "".join([c for c in title if c.isalpha() or c.isdigit() or c in " .-_()"]).strip()
            file_name = f"{clean_title}.mp4"

            # SAKTI: Ditambahkan --no-playlist juga di pencarian link
            cmd_url = ["yt-dlp", "--no-playlist", "--js-runtimes", "node", "-g", "-f", "b[ext=mp4]/b", self.youtube_url]
            proc_url = subprocess.Popen(cmd_url, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            stdout_url, _ = proc_url.communicate(timeout=15)
            stream_url = stdout_url.strip()

            if proc_url.returncode == 0 and stream_url:
                if "m3u8" in stream_url or "manifest" in stream_url:
                    self.extraction_done.emit("use_ytdlp_direct", self.youtube_url, file_name)
                else:
                    self.extraction_done.emit("success", stream_url, file_name)
                return
            self.extraction_done.emit("failed", "", "")
        except subprocess.TimeoutExpired:
            # Jika memakan waktu terlalu lama (>15 detik), gagalkan agar tidak stuck di jam pasir
            self.extraction_done.emit("error", "Waktu ekstraksi habis (Timeout)", "")
        except Exception as e:
            self.extraction_done.emit("error", str(e), "")

class DataManagerDialog(QDialog):
    def __init__(self, title, file_path, callback_open_url, parent=None, is_history=False):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.resize(600, 450)
        self.setStyleSheet(STYLE_SHEET)
        self.file_path = file_path
        self.callback_open_url = callback_open_url
        self.is_history = is_history
        self.layout = QVBoxLayout(self)

        header_layout = QHBoxLayout()
        self.label_title = QLabel(f"<b>Daftar {title}</b>")
        header_layout.addWidget(self.label_title)

        if self.is_history:
            self.btn_clear = QPushButton("🗑️ Bersihkan Riwayat")
            self.btn_clear.setStyleSheet("background-color: #e53935; color: white; font-weight: bold; padding: 4px 10px; border-radius: 4px;")
            self.btn_clear.clicked.connect(self.clear_all_data)
            header_layout.addWidget(self.btn_clear)

        self.layout.addLayout(header_layout)
        self.list_widget = QListWidget()
        self.list_widget.itemDoubleClicked.connect(self.handle_item_clicked)
        self.layout.addWidget(self.list_widget)
        self.load_data()

    def load_data(self):
        self.list_widget.clear()
        if not os.path.exists(self.file_path): return
        try:
            with open(self.file_path, "r") as f:
                data_list = json.load(f)
            for item in reversed(data_list):
                display_text = f"[{item.get('time', '')}] {item.get('title', 'No Title')} \n🔗 {item.get('url', '')}" if self.is_history else f"⭐ {item.get('title', 'No Title')} \n🔗 {item.get('url', '')}"
                list_item = QListWidgetItem(display_text)
                list_item.setData(Qt.ItemDataRole.UserRole, item.get('url'))
                self.list_widget.addItem(list_item)
        except: pass

    def handle_item_clicked(self, item):
        url = item.data(Qt.ItemDataRole.UserRole)
        if url:
            self.callback_open_url(url)
            self.accept()

    def clear_all_data(self):
        try:
            with open(self.file_path, "w") as f: json.dump([], f)
            self.load_data()
        except: pass

class DownloadManagerDialog(QDialog):
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setWindowTitle("Nero Download Manager")
        self.resize(550, 400)
        self.setStyleSheet(STYLE_SHEET)
        self.setWindowFlags(self.windowFlags() | Qt.WindowType.WindowStaysOnTopHint)
        self.layout = QVBoxLayout(self)

        self.label_title = QLabel("<b>Daftar Unduhan (Aria2c Engine)</b>")
        self.layout.addWidget(self.label_title)

        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll_content = QWidget()
        self.scroll_layout = QVBoxLayout(self.scroll_content)
        self.scroll_layout.setAlignment(Qt.AlignmentFlag.AlignTop)
        self.scroll.setWidget(self.scroll_content)
        self.layout.addWidget(self.scroll)

        self.download_widgets = {}
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_all_progress)
        self.timer.start(1000)

    def add_download(self, gid, file_name):
        item_widget = QWidget()
        item_layout = QVBoxLayout(item_widget)
        lbl_name = QLabel(f"📄 {file_name}")
        lbl_name.setWordWrap(True)
        prog_bar = QProgressBar()
        prog_bar.setRange(0, 100)
        lbl_status = QLabel("Menghubungkan ke Server Aria2c...")

        btn_layout = QHBoxLayout()
        btn_pause = QPushButton("⏸ Pause")
        btn_resume = QPushButton("▶ Resume")
        btn_delete = QPushButton("🗑️ Hapus")
        btn_pause.setObjectName("btn-action")
        btn_resume.setObjectName("btn-action")
        btn_delete.setStyleSheet("background-color: #e53935; color: white; font-weight: bold; border-radius:4px; padding: 4px 10px;")

        btn_pause.clicked.connect(lambda: self.aria2_rpc("aria2.pause", gid))
        btn_resume.clicked.connect(lambda: self.aria2_rpc("aria2.unpause", gid))
        btn_delete.clicked.connect(lambda: self.remove_specific_download(gid))

        btn_layout.addWidget(btn_pause)
        btn_layout.addWidget(btn_resume)
        btn_layout.addWidget(btn_delete)
        btn_layout.addStretch()

        item_layout.addWidget(lbl_name)
        item_layout.addWidget(prog_bar)
        item_layout.addWidget(lbl_status)
        item_layout.addLayout(btn_layout)

        line = QWidget()
        line.setStyleSheet("background-color: #3c3b43; max-height: 1px;")
        item_layout.addWidget(line)
        self.scroll_layout.addWidget(item_widget)

        self.download_widgets[gid] = {"bar": prog_bar, "status": lbl_status, "widget": item_widget, "is_finished": False}

    def aria2_rpc(self, method, gid):
        try:
            req_data = json.dumps({"jsonrpc": "2.0", "id": "nero", "method": method, "params": [gid]}).encode()
            req = urllib.request.Request("http://localhost:6800/jsonrpc", data=req_data, headers={'Content-Type': 'application/json'})
            urllib.request.urlopen(req, timeout=1)
        except: pass

    def update_all_progress(self):
        try:
            req_data = json.dumps({"jsonrpc": "2.0", "id": "nero", "method": "aria2.tellActive", "params": []}).encode()
            req = urllib.request.Request("http://localhost:6800/jsonrpc", data=req_data, headers={'Content-Type': 'application/json'})
            with urllib.request.urlopen(req, timeout=1) as response:
                active_downloads = json.loads(response.read().decode())['result']
            for dl in active_downloads:
                gid = dl['gid']
                if gid in self.download_widgets:
                    completed = int(dl['completedLength'])
                    total = int(dl['totalLength'])
                    speed = int(dl['downloadSpeed']) / 1024 / 1024
                    percent = int((completed / total) * 100) if total > 0 else 0
                    self.download_widgets[gid]["bar"].setValue(percent)
                    self.download_widgets[gid]["status"].setText(f"Status: Mendownload... | Kecepatan: {speed:.2f} MB/s")
                    self.download_widgets[gid]["status"].setStyleSheet("color: #ffffff;")
                    self.download_widgets[gid]["is_finished"] = False
        except: pass

        try:
            req_data_waiting = json.dumps({"jsonrpc": "2.0", "id": "nero", "method": "aria2.tellWaiting", "params": [0, 50]}).encode()
            req_waiting = urllib.request.Request("http://localhost:6800/jsonrpc", data=req_data_waiting, headers={'Content-Type': 'application/json'})
            with urllib.request.urlopen(req_waiting, timeout=1) as response_waiting:
                waiting_downloads = json.loads(response_waiting.read().decode())['result']
            for dl in waiting_downloads:
                gid = dl['gid']
                if gid in self.download_widgets and dl['status'] == 'paused':
                    self.download_widgets[gid]["status"].setText("Status: ⏸ Di-Pause")
                    self.download_widgets[gid]["status"].setStyleSheet("color: #ffaa00;")
        except: pass

        try:
            req_data_stopped = json.dumps({"jsonrpc": "2.0", "id": "nero", "method": "aria2.tellStopped", "params": [0, 50]}).encode()
            req_stopped = urllib.request.Request("http://localhost:6800/jsonrpc", data=req_data_stopped, headers={'Content-Type': 'application/json'})
            with urllib.request.urlopen(req_stopped, timeout=1) as response_stopped:
                stopped_downloads = json.loads(response_stopped.read().decode())['result']
            for dl in stopped_downloads:
                gid = dl['gid']
                if gid in self.download_widgets:
                    self.download_widgets[gid]["is_finished"] = True
                    if dl['status'] == 'complete':
                        self.download_widgets[gid]["bar"].setValue(100)
                        self.download_widgets[gid]["status"].setText("Status: ✨ Selesai Berhasil")
                        self.download_widgets[gid]["status"].setStyleSheet("color: #00ddff;")
                    elif dl['status'] == 'removed':
                        self.download_widgets[gid]["status"].setText("Status: ✖ Dihapus")
                        self.download_widgets[gid]["status"].setStyleSheet("color: #ff3333;")
                    elif dl['status'] == 'error':
                        self.download_widgets[gid]["status"].setText("Status: ⚠️ Gagal/Eror!")
                        self.download_widgets[gid]["status"].setStyleSheet("color: #ffaa00;")
        except: pass

    def remove_specific_download(self, gid):
        if gid in self.download_widgets:
            info = self.download_widgets[gid]
            try:
                self.aria2_rpc("aria2.forceRemove", gid)
                self.aria2_rpc("aria2.purgeDownloadResult", gid)
            except: pass
            if info["widget"]:
                self.scroll_layout.removeWidget(info["widget"])
                info["widget"].setParent(None)
                info["widget"].deleteLater()
            del self.download_widgets[gid]

class NeroWebPage(QWebEnginePage):
    def acceptNavigationRequest(self, url, _type, isMainFrame):
        url_str = url.toString()
        ad_domains = ["doubleclick.net", "googleads", "adservice", "popads", "adnxs", "pagead2", "googlesyndication"]
        if any(domain in url_str for domain in ad_domains):
            return False
        return True

